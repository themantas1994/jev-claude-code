{
  "description": "Jev engineering: dependency setup, permission gate, output ladder, conditional context, subagent routing",
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/setup.sh\"", "timeout": 300,
                  "statusMessage": "Jev: installing Python dependencies (first run only)"}]},
      {"matcher": "compact",
       "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/run-hook.sh\" session_context"}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/run-hook.sh\" prompt_context", "timeout": 15}]}
    ],
    "PreToolUse": [
      {"matcher": "Bash",
       "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/run-hook.sh\" permission_gate",
                  "timeout": 20, "statusMessage": "Jev: checking command"}]},
      {"matcher": "Agent",
       "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/run-hook.sh\" agent_router",
                  "timeout": 20, "statusMessage": "Jev: routing subagent"}]}
    ],
    "PostToolUse": [
      {"matcher": "Bash",
       "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/run-hook.sh\" output_ladder", "timeout": 20}]},
      {"matcher": "Agent",
       "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/run-hook.sh\" agent_done"}]}
    ]
  }
}
